# Local development environment variables (copy to .env and fill values)
# DO NOT commit .env with real secrets

# --- Database configuration (single place to manage DB values for all services) ---
AUTH_DB_HOST=auth-db
AUTH_DB_PORT=3306
AUTH_DB_NAME=auth_db
AUTH_DB_USERNAME=root
AUTH_DB_PASSWORD=rootpw
AUTH_DB_ROOT_PASSWORD=rootpw
AUTH_DB_URL=jdbc:mysql://auth-db:3306/auth_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true

PG_DB_HOST=pg-db
PG_DB_PORT=3306
PG_DB_NAME=pg_db
PG_DB_USERNAME=root
PG_DB_PASSWORD=rootpw
PG_DB_ROOT_PASSWORD=rootpw
PG_DB_URL=jdbc:mysql://pg-db:3306/pg_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true

# --- App security ---
AUTH_JWT_SECRET=change_this_local_secret
APP_JWT_EXP_MS=28800000

# --- Deployment / environment mapping ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=4000

# Docker Hub credentials for CI (do not store here; use GitHub Secrets)
# DOCKERHUB_USERNAME=
# DOCKERHUB_TOKEN=

# Kubernetes kubeconfigs (not for .env in production)
# KUBE_CONFIG_UAT=
# KUBE_CONFIG_SIT=
# KUBE_CONFIG_NFT=
# KUBE_CONFIG_PREPROD=
# KUBE_CONFIG_PROD=
