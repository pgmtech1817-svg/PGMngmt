# Development environment (local Docker)
# WARNING: Use only for local development. Do NOT use these credentials in UAT/PROD.

AUTH_DB_ROOT_PASSWORD=root
PG_DB_ROOT_PASSWORD=root
AUTH_DB_PASSWORD=root
PG_DB_PASSWORD=root
AUTH_DB_USERNAME=root
PG_DB_USERNAME=root
AUTH_DB_NAME=auth_db
PG_DB_NAME=pg_db
AUTH_DB_URL=jdbc:mysql://auth-db:3306/auth_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
PG_DB_URL=jdbc:mysql://pg-db:3306/pg_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true

# App
AUTH_JWT_SECRET=change_this_local_secret
APP_JWT_EXP_MS=28800000
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=4000
